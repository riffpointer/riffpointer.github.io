---
permalink: /assets/data/command-palette-data.json
---
{
  "commands": {{ site.data.command_palette | jsonify }},
  "projects": [
    {%- for project in site.data.projects -%}
      {
        "title": {{ project.name | jsonify }},
        "href": {{ "https://github.com/riffpointer/" | append: project.id | jsonify }},
        "description": {{ project.description | jsonify }},
        "icon": "github",
        "keywords": {{ project.tags | jsonify }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "posts": [
    {% for post in site.posts %}
      {
        "title": {{ post.title | jsonify }},
        "href": {{ post.url | relative_url | jsonify }},
        "description": {{ post.description | default: post.excerpt | strip_html | truncatewords: 10 | jsonify }},
        "icon": "journal-text"
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
