{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "attribute-boolean-style": "off",
    "void-style": "off",
    "no-inline-style": "off",
    "wcag/h63": "off",
    "wcag/h30": "off",
    "unique-landmark": "off",
    "prefer-native-element": "off",
    "aria-label-misuse": "off",
    "no-dup-id": "off",
    "close-order": "error",
    "valid-id": "off"
  }
}
